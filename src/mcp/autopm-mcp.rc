#include <windows.h>

// Same icon as the application: it is the same product, and without one
// Explorer shows the generic console image beside AutoPM.exe.
#define IDI_APPICON 1
IDI_APPICON ICON "../../assets/autopm.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,2,0,0
PRODUCTVERSION  0,2,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Locke Werks"
            VALUE "FileDescription",  "AutoPM MCP server"
            VALUE "FileVersion",      "0.2.0.0"
            VALUE "InternalName",     "autopm-mcp"
            VALUE "LegalCopyright",   "Nyx Locke"
            VALUE "OriginalFilename", "autopm-mcp.exe"
            VALUE "ProductName",      "AutoPM"
            VALUE "ProductVersion",   "0.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
