#include <windows.h>

// Declared first so Explorer uses it as the file icon.
#define IDI_APPICON 1
IDI_APPICON ICON "../../assets/autopm.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Locke Werks"
            VALUE "FileDescription",  "AutoPM"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "AutoPM"
            VALUE "LegalCopyright",   "Nyx Locke"
            VALUE "OriginalFilename", "AutoPM.exe"
            VALUE "ProductName",      "AutoPM"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
